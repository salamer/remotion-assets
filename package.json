{
  "name": "finance-motion",
  "version": "2.0.0",
  "description": "Data-driven financial video production system with unified brands, validated storyboards and a visual workbench",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "@remotion/fonts": "4.0.507",
    "@remotion/tailwind-v4": "4.0.507",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.507",
    "tailwindcss": "4.2.0",
    "@remotion/player": "4.0.507",
    "zod": "4.4.3",
    "@remotion/bundler": "4.0.507",
    "@remotion/renderer": "4.0.507",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.507",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "tsx": "4.20.3",
    "@types/node": "22.15.30",
    "vite": "6.3.5",
    "@tailwindcss/vite": "4.2.0",
    "@types/react-dom": "19.2.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src studio scripts tests && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm validate examples/episode.json",
    "validate": "node --import tsx scripts/validate.ts",
    "render": "node --import tsx scripts/render.ts",
    "catalog": "node --import tsx scripts/catalog.ts",
    "schema": "node --import tsx scripts/schema.ts",
    "workbench": "vite --host 0.0.0.0",
    "workbench:build": "vite build",
    "render:sample": "node --import tsx scripts/render.ts examples/episode.json out/episode.mp4",
    "stills": "node --import tsx scripts/stills.ts",
    "export:plan": "node --import tsx scripts/export-plan.ts",
    "captions:import": "node --import tsx scripts/import-captions.ts",
    "styles": "node --import tsx scripts/styles.ts",
    "legacy:stills": "node --import tsx scripts/legacy-stills.ts"
  },
  "sideEffects": [
    "*.css",
    "./src/style/fonts.ts"
  ],
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
  "engines": {
    "node": ">=22.0.0"
  }
}
